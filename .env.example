# Copie para .env e preencha. Nada aqui é um segredo real.
# Sem essas credenciais, os clientes de integração operam em modo mock.

# Google Ads (MCP server / googleads-python-lib)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=

# API do Bot do Afiliado (botdoafiliado.com)
BOT_AFILIADO_API_KEY=
BOT_AFILIADO_BASE_URL=https://botdoafiliado.com/api/v1/

# LLM usado no motor de conteúdo RAG 90/10
ANTHROPIC_API_KEY=

# Regras de negócio (opcional, usa os defaults do README se omitido)
COMISSAO_MINIMA_PCT=10.0
ALTO_TICKET_LUCRO_MIN=40.0
ALTO_TICKET_LUCRO_MAX=50.0
