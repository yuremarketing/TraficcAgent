# Copie para .env e preencha. Nada aqui é um segredo real.
# Sem essas credenciais, os clientes de integração operam em modo mock.

# Google Ads (MCP server / googleads-python-lib)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_TRANSPORT=stdio
GOOGLE_ADS_MCP_URL=http://localhost:8080/mcp
GOOGLE_ADS_MCP_TOOL=search
GOOGLE_ADS_MCP_COMMAND=google-ads-mcp
GOOGLE_ADS_MCP_MAX_RETRIES=3
GOOGLE_PROJECT_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# API do Bot do Afiliado (botdoafiliado.com)
BOT_AFILIADO_API_KEY=
BOT_AFILIADO_BASE_URL=https://botdoafiliado.com/api/v1/

# LLM usado no motor de conteúdo RAG 90/10
ANTHROPIC_API_KEY=

# Regras de negócio (opcional, usa os defaults do README se omitido)
COMISSAO_MINIMA_PCT=10.0
ALTO_TICKET_LUCRO_MIN=40.0
ALTO_TICKET_LUCRO_MAX=50.0

# Banco de Dados (PostgreSQL / docker-compose.yml - Issue #29)
POSTGRES_USER=traficcagent
POSTGRES_PASSWORD=
POSTGRES_DB=traficcagent
# String de conexão usada pela API (traficcagent/db.py). Em produção/Docker,
# aponta pro serviço "db" do docker-compose.yml — troque SUA_SENHA_AQUI pelo
# mesmo valor de POSTGRES_PASSWORD acima (o .env não faz substituição de
# variável dentro dele mesmo). Sem essa variável, a API cai em SQLite local
# (./traficcagent.db) — só pra dev sem container.
DATABASE_URL=postgresql://traficcagent:SUA_SENHA_AQUI@db:5432/traficcagent

# Agent Loop — Claude + Gemini (scripts/agent-loop/run.sh)
AGENT_LOOP_REPO=yuremarketing/TraficcAgent
AGENT_LOOP_FIRST_AGENT=gemini
AGENT_LOOP_MAX_TURNS=20
# Branches observadas pra detectar mudança no git (separadas por espaço)
AGENT_LOOP_WATCH_BRANCHES="master dev/philipy"
# Teto de turnos do debate "qual a próxima tarefa" antes de seguir com a última proposta
AGENT_LOOP_DEBATE_MAX_TURNS=6
AGENT_LOOP_PROJECT_NUMBER=
AGENT_LOOP_POST_TO_ISSUE=1
AGENT_LOOP_AUTO_PUSH=0
